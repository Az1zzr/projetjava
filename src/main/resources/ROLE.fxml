<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controller.AjouterRole"
           style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">

    <!-- Conteneur principal -->
    <VBox spacing="0" alignment="CENTER" maxWidth="900" maxHeight="750"
          style="-fx-background-color: white;
                 -fx-background-radius: 25px;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 25, 0, 0, 8);">

        <!-- En-tête -->
        <VBox alignment="CENTER" spacing="12"
              style="-fx-background-color: linear-gradient(to right, #2563eb, #3b82f6);
                     -fx-background-radius: 25 25 0 0;
                     -fx-padding: 35 25 35 25;">

            <Label text="⭐" style="-fx-font-size: 50px;"/>

            <Label text="Gestion des Rôles"
                   style="-fx-font-family: 'Poppins', 'Montserrat', sans-serif;
                          -fx-font-size: 32px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <Label text="Ajoutez et gérez les rôles utilisateurs"
                   style="-fx-font-family: 'Roboto', 'Open Sans', sans-serif;
                          -fx-font-size: 14px;
                          -fx-text-fill: rgba(255,255,255,0.9);"/>
        </VBox>

        <!-- Section Formulaire -->
        <VBox spacing="25" alignment="CENTER">
            <padding>
                <Insets top="35" right="45" bottom="20" left="45"/>
            </padding>

            <!-- Label du formulaire -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📝" style="-fx-font-size: 24px;"/>
                <Label text="Ajouter un nouveau rôle"
                       style="-fx-font-family: 'Poppins', 'Montserrat', sans-serif;
                              -fx-font-size: 20px;
                              -fx-font-weight: 600;
                              -fx-text-fill: #1e293b;"/>
            </HBox>

            <!-- Champ Nom du Rôle -->
            <VBox spacing="10" alignment="CENTER">
                <Label text="Nom du rôle"
                       style="-fx-font-family: 'Roboto', 'Open Sans', sans-serif;
                              -fx-font-weight: bold;
                              -fx-font-size: 14px;
                              -fx-text-fill: #475569;">
                    <graphic>
                        <Label text="🏷️" style="-fx-font-size: 16px;"/>
                    </graphic>
                </Label>

                <HBox spacing="15" alignment="CENTER">
                    <TextField fx:id="nomRoleField"
                               promptText="Ex: Fournisseur, Entrepreneur, Admin..."
                               style="-fx-pref-width: 500px;
                                      -fx-pref-height: 50px;
                                      -fx-background-color: #f8fafc;
                                      -fx-background-radius: 12px;
                                      -fx-border-color: #e2e8f0;
                                      -fx-border-width: 2px;
                                      -fx-border-radius: 12px;
                                      -fx-font-family: 'Roboto', 'Open Sans', sans-serif;
                                      -fx-font-size: 15px;
                                      -fx-padding: 12;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"/>

                    <Button text="➕ Ajouter"
                            onAction="#ajouterRole"
                            style="-fx-background-color: linear-gradient(to right, #10b981, #059669);
                                   -fx-text-fill: white;
                                   -fx-font-family: 'Poppins', 'Montserrat', sans-serif;
                                   -fx-font-weight: bold;
                                   -fx-font-size: 15px;
                                   -fx-pref-height: 50px;
                                   -fx-padding: 12 40 12 40;
                                   -fx-background-radius: 12px;
                                   -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.4), 12, 0, 0, 4);">
                        <font>
                            <Font name="Poppins Bold" size="15"/>
                        </font>
                    </Button>
                </HBox>
            </VBox>

            <!-- Séparateur -->
            <Separator prefWidth="800"
                       style="-fx-background-color: #e2e8f0;
                             -fx-pref-height: 2px;"/>

            <!-- Label du tableau -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📋" style="-fx-font-size: 24px;"/>
                <Label text="Liste des rôles existants"
                       style="-fx-font-family: 'Poppins', 'Montserrat', sans-serif;
                              -fx-font-size: 20px;
                              -fx-font-weight: 600;
                              -fx-text-fill: #1e293b;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="countLabel"
                       text="0 rôle(s)"
                       style="-fx-font-family: 'Roboto', 'Open Sans', sans-serif;
                              -fx-font-size: 13px;
                              -fx-text-fill: #64748b;
                              -fx-background-color: #f1f5f9;
                              -fx-padding: 6 16 6 16;
                              -fx-background-radius: 20px;"/>
            </HBox>

            <!-- TableView -->
            <TableView fx:id="roleTable"
                       prefWidth="800"
                       prefHeight="300"
                       style="-fx-background-color: transparent;
                              -fx-background-radius: 15px;
                              -fx-border-color: #e2e8f0;
                              -fx-border-width: 2px;
                              -fx-border-radius: 15px;
                              -fx-font-family: 'Roboto', 'Open Sans', sans-serif;">

                <columns>
                    <TableColumn fx:id="colId"
                                 text="🆔 ID Rôle"
                                 prefWidth="150"
                                 style="-fx-alignment: CENTER;
                                        -fx-font-family: 'Poppins', 'Montserrat', sans-serif;
                                        -fx-font-weight: bold;
                                        -fx-font-size: 13px;"/>

                    <TableColumn fx:id="colNom"
                                 text="🏷️ Nom du Rôle"
                                 prefWidth="400"
                                 style="-fx-font-family: 'Poppins', 'Montserrat', sans-serif;
                                        -fx-font-weight: bold;
                                        -fx-font-size: 13px;"/>

                    <TableColumn fx:id="colActions"
                                 text="⚙️ Actions"
                                 prefWidth="230"
                                 style="-fx-alignment: CENTER;
                                        -fx-font-family: 'Poppins', 'Montserrat', sans-serif;
                                        -fx-font-weight: bold;
                                        -fx-font-size: 13px;"/>
                </columns>

                <placeholder>
                    <VBox alignment="CENTER" spacing="15">
                        <Label text="📭" style="-fx-font-size: 56px;"/>
                        <Label text="Aucun rôle trouvé"
                               style="-fx-font-family: 'Roboto', 'Open Sans', sans-serif;
                                      -fx-font-size: 18px;
                                      -fx-text-fill: #94a3b8;"/>
                        <Label text="Ajoutez votre premier rôle ci-dessus"
                               style="-fx-font-family: 'Roboto', 'Open Sans', sans-serif;
                                      -fx-font-size: 14px;
                                      -fx-text-fill: #cbd5e1;"/>
                    </VBox>
                </placeholder>
            </TableView>

            <!-- Boutons d'action -->
            <HBox spacing="18" alignment="CENTER">
                <padding>
                    <Insets top="15" bottom="25"/>
                </padding>

                <Button text="◀ Retour"
                        onAction="#handleBackToUsers"
                        style="-fx-background-color: #64748b;
                               -fx-text-fill: white;
                               -fx-font-family: 'Poppins', 'Montserrat', sans-serif;
                               -fx-font-weight: bold;
                               -fx-font-size: 14px;
                               -fx-padding: 14 32 14 32;
                               -fx-background-radius: 12px;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(100, 116, 139, 0.4), 10, 0, 0, 4);">
                    <font>
                        <Font name="Poppins Bold" size="14"/>
                    </font>
                </Button>

                <Button text="🔄 Actualiser"
                        onAction="#handleRefresh"
                        style="-fx-background-color: linear-gradient(to right, #2563eb, #3b82f6);
                               -fx-text-fill: white;
                               -fx-font-family: 'Poppins', 'Montserrat', sans-serif;
                               -fx-font-weight: bold;
                               -fx-font-size: 14px;
                               -fx-padding: 14 32 14 32;
                               -fx-background-radius: 12px;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(37, 99, 235, 0.4), 10, 0, 0, 4);">
                    <font>
                        <Font name="Poppins Bold" size="14"/>
                    </font>
                </Button>

                <Button text="✏️ Modifier"
                        onAction="#handleModify"
                        style="-fx-background-color: linear-gradient(to right, #f97316, #fb923c);
                               -fx-text-fill: white;
                               -fx-font-family: 'Poppins', 'Montserrat', sans-serif;
                               -fx-font-weight: bold;
                               -fx-font-size: 14px;
                               -fx-padding: 14 32 14 32;
                               -fx-background-radius: 12px;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(249, 115, 22, 0.4), 10, 0, 0, 4);">
                    <font>
                        <Font name="Poppins Bold" size="14"/>
                    </font>
                </Button>

                <Button text="🗑️ Supprimer"
                        onAction="#handleDelete"
                        style="-fx-background-color: linear-gradient(to right, #dc2626, #ef4444);
                               -fx-text-fill: white;
                               -fx-font-family: 'Poppins', 'Montserrat', sans-serif;
                               -fx-font-weight: bold;
                               -fx-font-size: 14px;
                               -fx-padding: 14 32 14 32;
                               -fx-background-radius: 12px;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(220, 38, 38, 0.4), 10, 0, 0, 4);">
                    <font>
                        <Font name="Poppins Bold" size="14"/>
                    </font>
                </Button>
            </HBox>

        </VBox>

    </VBox>

</StackPane>
