<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controller.AjouterUser"
           style="-fx-background-color: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);">

    <!-- Carte principale -->
    <VBox alignment="CENTER" spacing="0" maxWidth="550" maxHeight="750"
          style="-fx-background-color: white;
                 -fx-background-radius: 25px;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 25, 0, 0, 8);">

        <!-- En-tête avec icône -->
        <VBox alignment="CENTER" spacing="12"
              style="-fx-background-color: linear-gradient(to right, #2563eb, #3b82f6);
                     -fx-background-radius: 25 25 0 0;
                     -fx-padding: 35 25 35 25;">

            <Label text="👤" style="-fx-font-size: 50px;"/>

            <Label text="Ajouter un Utilisateur"
                   style="-fx-font-family: 'Poppins', 'Montserrat', sans-serif;
                          -fx-font-size: 30px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <Label text="Remplissez les informations ci-dessous"
                   style="-fx-font-family: 'Roboto', 'Open Sans', sans-serif;
                          -fx-font-size: 14px;
                          -fx-text-fill: rgba(255,255,255,0.9);"/>
        </VBox>

        <!-- Formulaire -->
        <VBox spacing="22" alignment="CENTER">
            <padding>
                <Insets top="32" right="45" bottom="32" left="45"/>
            </padding>

            <!-- Champ Nom -->
            <VBox spacing="10">
                <Label text="Nom complet"
                       style="-fx-font-family: 'Roboto', 'Open Sans', sans-serif;
                              -fx-font-weight: bold;
                              -fx-font-size: 14px;
                              -fx-text-fill: #475569;">
                    <graphic>
                        <Label text="👤" style="-fx-font-size: 16px;"/>
                    </graphic>
                </Label>
                <TextField fx:id="nameField"
                           promptText="Ex: Ahmed Ben Ali"
                           style="-fx-pref-width: 440px;
                                  -fx-pref-height: 48px;
                                  -fx-background-color: #f8fafc;
                                  -fx-background-radius: 12px;
                                  -fx-border-color: #e2e8f0;
                                  -fx-border-width: 2px;
                                  -fx-border-radius: 12px;
                                  -fx-font-family: 'Roboto', 'Open Sans', sans-serif;
                                  -fx-font-size: 15px;
                                  -fx-padding: 12;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"/>
            </VBox>

            <!-- Champ Email -->
            <VBox spacing="10">
                <Label text="Adresse email"
                       style="-fx-font-family: 'Roboto', 'Open Sans', sans-serif;
                              -fx-font-weight: bold;
                              -fx-font-size: 14px;
                              -fx-text-fill: #475569;">
                    <graphic>
                        <Label text="📧" style="-fx-font-size: 16px;"/>
                    </graphic>
                </Label>
                <TextField fx:id="emailField"
                           promptText="Ex: ahmed@example.com"
                           style="-fx-pref-width: 440px;
                                  -fx-pref-height: 48px;
                                  -fx-background-color: #f8fafc;
                                  -fx-background-radius: 12px;
                                  -fx-border-color: #e2e8f0;
                                  -fx-border-width: 2px;
                                  -fx-border-radius: 12px;
                                  -fx-font-family: 'Roboto', 'Open Sans', sans-serif;
                                  -fx-font-size: 15px;
                                  -fx-padding: 12;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"/>
            </VBox>

            <!-- Champ Mot de passe avec bouton voir/cacher -->
            <VBox spacing="10">
                <Label text="Mot de passe"
                       style="-fx-font-family: 'Roboto', 'Open Sans', sans-serif;
                              -fx-font-weight: bold;
                              -fx-font-size: 14px;
                              -fx-text-fill: #475569;">
                    <graphic>
                        <Label text="🔒" style="-fx-font-size: 16px;"/>
                    </graphic>
                </Label>
                <StackPane>
                    <PasswordField fx:id="passwordField"
                                   promptText="Minimum 6 caractères"
                                   style="-fx-pref-width: 440px;
                                          -fx-pref-height: 48px;
                                          -fx-background-color: #f8fafc;
                                          -fx-background-radius: 12px;
                                          -fx-border-color: #e2e8f0;
                                          -fx-border-width: 2px;
                                          -fx-border-radius: 12px;
                                          -fx-font-family: 'Roboto', 'Open Sans', sans-serif;
                                          -fx-font-size: 15px;
                                          -fx-padding: 12 55 12 12;
                                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"/>

                    <TextField fx:id="visiblePasswordField"
                               promptText="Minimum 6 caractères"
                               visible="false"
                               managed="false"
                               style="-fx-pref-width: 440px;
                                      -fx-pref-height: 48px;
                                      -fx-background-color: #f8fafc;
                                      -fx-background-radius: 12px;
                                      -fx-border-color: #e2e8f0;
                                      -fx-border-width: 2px;
                                      -fx-border-radius: 12px;
                                      -fx-font-family: 'Roboto', 'Open Sans', sans-serif;
                                      -fx-font-size: 15px;
                                      -fx-padding: 12 55 12 12;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"/>

                    <!-- Bouton pour voir/cacher le mot de passe -->
                    <Button fx:id="togglePasswordButton"
                            text="👁️"
                            onAction="#togglePasswordVisibility"
                            style="-fx-background-color: transparent;
                                   -fx-cursor: hand;
                                   -fx-font-size: 20px;
                                   -fx-padding: 8 12 8 12;"
                            StackPane.alignment="CENTER_RIGHT">
                        <StackPane.margin>
                            <Insets right="12"/>
                        </StackPane.margin>
                    </Button>
                </StackPane>
            </VBox>

            <!-- Champ Rôle -->
            <VBox spacing="10">
                <Label text="Rôle"
                       style="-fx-font-family: 'Roboto', 'Open Sans', sans-serif;
                              -fx-font-weight: bold;
                              -fx-font-size: 14px;
                              -fx-text-fill: #475569;">
                    <graphic>
                        <Label text="⭐" style="-fx-font-size: 16px;"/>
                    </graphic>
                </Label>
                <ChoiceBox fx:id="roleChoice"
                           style="-fx-pref-width: 440px;
                                  -fx-pref-height: 48px;
                                  -fx-background-color: #f8fafc;
                                  -fx-background-radius: 12px;
                                  -fx-font-family: 'Roboto', 'Open Sans', sans-serif;
                                  -fx-font-size: 15px;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"/>
            </VBox>

            <!-- Boutons -->
            <VBox spacing="12" alignment="CENTER">
                <padding>
                    <Insets top="18"/>
                </padding>

                <!-- Ligne 1: Ajouter et Voir liste -->
                <HBox spacing="15" alignment="CENTER">
                    <Button text="✓ Ajouter"
                            onAction="#handleAddUser"
                            style="-fx-background-color: linear-gradient(to right, #10b981, #059669);
                                   -fx-text-fill: white;
                                   -fx-font-family: 'Poppins', 'Montserrat', sans-serif;
                                   -fx-font-weight: bold;
                                   -fx-font-size: 15px;
                                   -fx-padding: 14 40 14 40;
                                   -fx-background-radius: 12px;
                                   -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.4), 12, 0, 0, 4);">
                        <font>
                            <Font name="Poppins Bold" size="15"/>
                        </font>
                    </Button>

                    <Button text="📋 Voir la liste"
                            onAction="#handleShowUserList"
                            style="-fx-background-color: linear-gradient(to right, #2563eb, #3b82f6);
                                   -fx-text-fill: white;
                                   -fx-font-family: 'Poppins', 'Montserrat', sans-serif;
                                   -fx-font-weight: bold;
                                   -fx-font-size: 15px;
                                   -fx-padding: 14 35 14 35;
                                   -fx-background-radius: 12px;
                                   -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(37, 99, 235, 0.4), 12, 0, 0, 4);">
                        <font>
                            <Font name="Poppins Bold" size="15"/>
                        </font>
                    </Button>
                </HBox>

                <!-- Ligne 2: Gérer les rôles -->
                <Button text="⭐ Gérer les Rôles"
                        onAction="#handleManageRoles"
                        style="-fx-background-color: linear-gradient(to right, #f97316, #fb923c);
                               -fx-text-fill: white;
                               -fx-font-family: 'Poppins', 'Montserrat', sans-serif;
                               -fx-font-weight: bold;
                               -fx-font-size: 14px;
                               -fx-padding: 12 45 12 45;
                               -fx-background-radius: 12px;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(249, 115, 22, 0.4), 12, 0, 0, 4);">
                    <font>
                        <Font name="Poppins Bold" size="14"/>
                    </font>
                </Button>
            </VBox>

        </VBox>

    </VBox>

</StackPane>
