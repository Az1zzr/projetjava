<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.PublicationsController"
      spacing="0"
      style="-fx-background-color: transparent;">

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background: transparent; -fx-background-color: transparent;
                       -fx-border-color: transparent;">
        <VBox spacing="16" style="-fx-padding: 4 60 20 60; -fx-background-color: transparent;">

            <!-- ══ 1. FILTRES + RECHERCHE ══ -->
            <VBox spacing="10"
                  style="-fx-background-color: white; -fx-background-radius: 16px;
                         -fx-padding: 14 18; -fx-border-color: #e2e8f0;
                         -fx-border-width: 1px; -fx-border-radius: 16px;
                         -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.05),6,0,0,2);">

                <!-- ── Titre + Barre de recherche ── -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="📰  Publications"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <!-- Cloche notifications -->
                    <StackPane onMouseClicked="#handleToggleNotifications" style="-fx-cursor: hand;">
                        <Button fx:id="btnNotif" text="🔔" onAction="#handleToggleNotifications"
                                style="-fx-background-color: transparent; -fx-font-size: 20px;
                                       -fx-padding: 4; -fx-cursor: hand;"/>
                        <Label fx:id="lblNotifBadge" text="0"
                               visible="false" managed="false"
                               style="-fx-background-color: #ef4444; -fx-text-fill: white;
                                      -fx-font-size: 9px; -fx-font-weight: bold;
                                      -fx-background-radius: 20px; -fx-padding: 1 5;
                                      -fx-min-width: 16px; -fx-alignment: center;"
                               StackPane.alignment="TOP_RIGHT"/>
                    </StackPane>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox alignment="CENTER_LEFT" spacing="0"
                          style="-fx-background-color: #f8fafc; -fx-background-radius: 10px;
                                 -fx-border-color: #e2e8f0; -fx-border-width: 1.5px;
                                 -fx-border-radius: 10px; -fx-pref-width: 320px;">
                        <Label text="  🔍  " style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>
                        <TextField fx:id="tfSearch"
                                   promptText="Rechercher un utilisateur, nom..."
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: transparent; -fx-border-color: transparent;
                                          -fx-font-size: 13px; -fx-padding: 8 10 8 0; -fx-pref-height: 38px;"/>
                        <Button fx:id="btnClearSearch" text="✕" onAction="#handleClearSearch"
                                visible="false" managed="false"
                                style="-fx-background-color: transparent; -fx-text-fill: #94a3b8;
                                       -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 4 8;"/>
                    </HBox>
                </HBox>

                <!-- ── Filtres par rôle ── -->
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 2 0 0 0;">
                    <Label text="Filtrer par rôle :" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                    <Button fx:id="btnFiltreAll"          text="🌐 Tous"          onAction="#filtrerTous"
                            style="-fx-background-color:#1e3a5f; -fx-text-fill:white; -fx-font-size:11px;
                                   -fx-font-weight:bold; -fx-background-radius:20px; -fx-padding:5 14; -fx-cursor:hand;"/>
                    <Button fx:id="btnFiltreFournisseur"  text="🏪 Fournisseurs"  onAction="#filtrerFournisseurs"
                            style="-fx-background-color:#fff7ed; -fx-text-fill:#f97316; -fx-border-color:#fed7aa;
                                   -fx-border-width:1px; -fx-font-size:11px; -fx-font-weight:bold;
                                   -fx-background-radius:20px; -fx-border-radius:20px; -fx-padding:5 14; -fx-cursor:hand;"/>
                    <Button fx:id="btnFiltreEntrepreneur" text="💼 Entrepreneurs" onAction="#filtrerEntrepreneurs"
                            style="-fx-background-color:#f0fdf4; -fx-text-fill:#10b981; -fx-border-color:#a7f3d0;
                                   -fx-border-width:1px; -fx-font-size:11px; -fx-font-weight:bold;
                                   -fx-background-radius:20px; -fx-border-radius:20px; -fx-padding:5 14; -fx-cursor:hand;"/>
                    <Button fx:id="btnFiltreMes"          text="👤 Mes posts"     onAction="#filtrerMesPosts"
                            style="-fx-background-color:#f5f3ff; -fx-text-fill:#7c3aed; -fx-border-color:#ddd6fe;
                                   -fx-border-width:1px; -fx-font-size:11px; -fx-font-weight:bold;
                                   -fx-background-radius:20px; -fx-border-radius:20px; -fx-padding:5 14; -fx-cursor:hand;"/>
                    <Button fx:id="btnFiltreGroupe"       text="👥 Groupe"         onAction="#filtrerGroupe"
                            style="-fx-background-color:#fdf4ff; -fx-text-fill:#a855f7; -fx-border-color:#e9d5ff;
                                   -fx-border-width:1px; -fx-font-size:11px; -fx-font-weight:bold;
                                   -fx-background-radius:20px; -fx-border-radius:20px; -fx-padding:5 14; -fx-cursor:hand;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- ── Tri ── -->
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 0 2 0;">
                    <Label text="Trier :" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                    <Button fx:id="btnTriRecent" text="🕐 Récents"    onAction="#trierRecents"
                            style="-fx-background-color:#f1f4f9; -fx-text-fill:#64748b;
                                   -fx-font-size:11px; -fx-background-radius:8px; -fx-padding:5 12; -fx-cursor:hand;"/>
                    <Button fx:id="btnTriPop"    text="❤️ Populaires" onAction="#trierPopulaires"
                            style="-fx-background-color:#f1f4f9; -fx-text-fill:#64748b;
                                   -fx-font-size:11px; -fx-background-radius:8px; -fx-padding:5 12; -fx-cursor:hand;"/>
                </HBox>

                <Label fx:id="lblResultat" text="" managed="false" visible="false"
                       style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
            </VBox>

            <!-- ══ 2. ZONE CRÉATION POST ══ -->
            <VBox spacing="0"
                  style="-fx-background-color: white; -fx-background-radius: 16px;
                         -fx-border-color: #e2e8f0; -fx-border-width: 1px; -fx-border-radius: 16px;
                         -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),8,0,0,2);">

                <!-- ── Ligne avatar + champ texte + icônes ── -->
                <HBox alignment="CENTER" spacing="10"
                      style="-fx-padding: 14 14 8 14;">

                    <!-- Avatar -->
                    <StackPane minWidth="42" minHeight="42" maxWidth="42" maxHeight="42"
                               style="-fx-background-color: #f97316; -fx-background-radius: 50%;">
                        <Label fx:id="lblCreateAvatar" text="M"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <ImageView fx:id="imgCreateAvatar" visible="false" managed="false"
                                   fitWidth="42" fitHeight="42" preserveRatio="false">
                            <clip><Circle centerX="21" centerY="21" radius="21"/></clip>
                        </ImageView>
                    </StackPane>

                    <!-- ✅ TextArea SEUL dans son HBox — pas de StackPane qui bloque -->
                    <TextArea fx:id="taNewPost"
                              promptText="Quoi de neuf ?"
                              wrapText="true" prefRowCount="2"
                              HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #f8fafc;
                                     -fx-background-radius: 14px;
                                     -fx-border-color: #e2e8f0;
                                     -fx-border-width: 1.5px;
                                     -fx-border-radius: 14px;
                                     -fx-font-size: 14px;
                                     -fx-text-fill: #1e293b;
                                     -fx-prompt-text-fill: #94a3b8;
                                     -fx-padding: 10 14;"/>

                    <!-- ✅ Icônes SÉPARÉES du TextArea — pas de superposition -->
                    <VBox alignment="CENTER" spacing="6">
                        <Button text="🖼️" onAction="#handleAddImage"
                                style="-fx-background-color: #f1f5f9;
                                       -fx-background-radius: 10px; -fx-font-size:17px;
                                       -fx-cursor:hand; -fx-padding: 6 8;
                                       -fx-border-color: #e2e8f0;
                                       -fx-border-width:1px; -fx-border-radius:10px;">
                            <tooltip><Tooltip text="Ajouter une photo"/></tooltip>
                        </Button>
                        <Button fx:id="btnToggleEmoji" text="🙂" onAction="#handleToggleEmoji"
                                style="-fx-background-color: #f1f5f9;
                                       -fx-background-radius: 10px; -fx-font-size:17px;
                                       -fx-cursor:hand; -fx-padding: 6 8;
                                       -fx-border-color: #e2e8f0;
                                       -fx-border-width:1px; -fx-border-radius:10px;">
                            <tooltip><Tooltip text="Emojis"/></tooltip>
                        </Button>
                    </VBox>
                </HBox>

                <!-- ── Compteur + Publier ── -->
                <HBox alignment="CENTER_RIGHT" spacing="10"
                      style="-fx-padding: 0 14 10 14;">
                    <Label fx:id="lblCharCount" text="0 / 500"
                           style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                    <Button text="Publier →" onAction="#handlePublier"
                            style="-fx-background-color: #f97316; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-background-radius: 20px; -fx-padding: 8 22; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian,rgba(249,115,22,0.5),10,0,0,3);"/>
                </HBox>

                <!-- ── Preview image ── -->
                <VBox fx:id="imagePreviewPane" visible="false" managed="false"
                      style="-fx-padding: 0 14 10 14;">
                    <VBox style="-fx-background-color:#f1f5f9; -fx-background-radius:12px; -fx-padding:8;">
                        <ImageView fx:id="imgPreview" fitWidth="999" fitHeight="220"
                                   preserveRatio="true" smooth="true" style="-fx-background-radius:10px;"/>
                        <Button text="✕  Supprimer l'image" onAction="#handleRemoveImage"
                                style="-fx-background-color:rgba(239,68,68,0.15); -fx-text-fill:#ef4444;
                                       -fx-font-size:11px; -fx-background-radius:8px;
                                       -fx-padding:5 14; -fx-cursor:hand; -fx-border-color:#ef4444;
                                       -fx-border-width:1px; -fx-border-radius:8px;">
                            <VBox.margin><Insets top="8" left="4"/></VBox.margin>
                        </Button>
                    </VBox>
                </VBox>

                <!-- ── PANNEAU EMOJI redesigné ── -->
                <VBox fx:id="emojiPanel" visible="false" managed="false"
                      style="-fx-background-color: #f8fafc;
                             -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;
                             -fx-background-radius: 0 0 16 16;
                             -fx-padding: 12 16 14 16;">

                    <!-- Titre catégorie -->
                    <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 0 8 0;">
                        <Label text="😊  Émojis" style="-fx-font-size: 12px; -fx-font-weight: bold;
                                                         -fx-text-fill: #64748b;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="✕  Fermer" onAction="#handleToggleEmoji"
                                style="-fx-background-color:transparent; -fx-text-fill:#4a6080;
                                       -fx-font-size:11px; -fx-cursor:hand; -fx-padding:2 6;"/>
                    </HBox>

                    <!-- Grille emojis - rangée 1 : Smileys -->
                    <Label text="Expressions" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;
                                                      -fx-padding: 0 0 4 2;"/>
                    <HBox spacing="6" style="-fx-padding: 0 0 8 0;">
                        <Button text="😊" onAction="#insertEmoji" userData="😊" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="😂" onAction="#insertEmoji" userData="😂" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="😍" onAction="#insertEmoji" userData="😍" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="🥳" onAction="#insertEmoji" userData="🥳" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="😎" onAction="#insertEmoji" userData="😎" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="😢" onAction="#insertEmoji" userData="😢" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="😡" onAction="#insertEmoji" userData="😡" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="🤔" onAction="#insertEmoji" userData="🤔" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="😴" onAction="#insertEmoji" userData="😴" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="🤩" onAction="#insertEmoji" userData="🤩" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                    </HBox>

                    <!-- Rangée 2 : Gestes -->
                    <Label text="Gestes" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8; -fx-padding: 0 0 4 2;"/>
                    <HBox spacing="6" style="-fx-padding: 0 0 8 0;">
                        <Button text="👍" onAction="#insertEmoji" userData="👍" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="👎" onAction="#insertEmoji" userData="👎" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="👏" onAction="#insertEmoji" userData="👏" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="🙏" onAction="#insertEmoji" userData="🙏" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="💪" onAction="#insertEmoji" userData="💪" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="🤝" onAction="#insertEmoji" userData="🤝" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="✌️" onAction="#insertEmoji" userData="✌️" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="🫶" onAction="#insertEmoji" userData="🫶" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                    </HBox>

                    <!-- Rangée 3 : Business LocalTrade -->
                    <Label text="Business" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8; -fx-padding: 0 0 4 2;"/>
                    <HBox spacing="6" style="-fx-padding: 0 0 8 0;">
                        <Button text="🏪" onAction="#insertEmoji" userData="🏪" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="💼" onAction="#insertEmoji" userData="💼" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="📦" onAction="#insertEmoji" userData="📦" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="🛍️" onAction="#insertEmoji" userData="🛍️" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="💰" onAction="#insertEmoji" userData="💰" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="🚀" onAction="#insertEmoji" userData="🚀" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="⭐" onAction="#insertEmoji" userData="⭐" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="🏆" onAction="#insertEmoji" userData="🏆" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="🎯" onAction="#insertEmoji" userData="🎯" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="💡" onAction="#insertEmoji" userData="💡" style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                    </HBox>

                    <!-- Rangée 4 : Divers -->
                    <Label text="Divers" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8; -fx-padding: 0 0 4 2;"/>
                    <HBox spacing="6">
                        <Button text="❤️"  onAction="#insertEmoji" userData="❤️"  style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="🔥"  onAction="#insertEmoji" userData="🔥"  style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="✅"  onAction="#insertEmoji" userData="✅"  style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="🎉"  onAction="#insertEmoji" userData="🎉"  style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
                        <Button text="📣"  onAction="#insertEmoji" userData="📣"  style="-fx-background-color:#f1f5f9; -fx-background-radius:10px; -fx-font-size:20px; -fx-cursor:hand; -fx-padding:6 8; -fx-border-color:#e2e8f0; -fx-border-radius:10px; -fx-border-width:1px;"/>
